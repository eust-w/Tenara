# Local data-plane stack credentials (dev defaults; never use in production).
# Copy to deploy/.env or export to override compose defaults.
#
# Host port map (remapped 2026-08-23 to coexist with other local containers;
# container-internal ports are unchanged — services talk via compose network):
#   postgres  127.0.0.1:15432 -> 5432
#   mongo     127.0.0.1:27117 -> 27017
#   redis     127.0.0.1:16379 -> 6379
#   minio     127.0.0.1:19000 -> 9000 (console 19001 -> 9001)
#   registry  127.0.0.1:5000  (unchanged)
#   mailhog   127.0.0.1:1025 / 8025 (unchanged)
POSTGRES_PASSWORD=tenara_pg_dev
MONGO_ROOT_PASSWORD=tenara_mongo_dev
REDIS_PASSWORD=tenara_redis_dev
MINIO_ROOT_USER=tenara_minio_dev
MINIO_ROOT_PASSWORD=tenara_minio_dev_pw
